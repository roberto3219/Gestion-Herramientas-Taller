<!DOCTYPE html>
<html lang="en"> 
<%- include('../partials/head') %>  
<body>
<%- include('../partials/header') %>
<div class="container mt-4">
  <h2 class="mb-3">Registrar Préstamo</h2>
  <form method="POST" action="/prestamos/add">
    <div class="mb-3">
      <label for="alumno" class="form-label">Nombre del Alumno</label>
      <select class="form-select" id="estudiante" name="estudiante" required>
        <option value="">Seleccione a un Estudiante</option>
        <% estudiantes.forEach(h => { %>
          <option value="<%= h.id %>"><%= h.nombre %> - <%= h.curso %></option>
        <% }) %>
      </select>    </div>

    <div class="mb-3">
      <label for="herramienta" class="form-label">Herramienta</label>
      <select class="form-select" id="herramienta" name="herramienta" required>
        <option value="">Seleccione una herramienta</option>
        <% herramientas.forEach(h => { %>
          <option value="<%= h.id %>"><%= h.nombre %> </option>
        <% }) %>
      </select>
    </div>


    <div class="mb-3">
      <label for="profesor" class="form-label">Profesor a cargo</label>
      <input type="text" value="<%= old.profesor %>" class="form-control" id="profesor" name="profesor" placeholder="Designe a un Profesor" required>
    </div>
    <div class="mb-3">
      <% if (errores && errores.cantidad) { %>
    <p class="text-danger"><%= errores.cantidad.msg %></p>
  <% } %>
      <label for="cantidad" class="form-label">Cantidad de herramientas a prestar</label>
      <input type="number" value="<%= old.cantidad %>" class="form-control" id="cantidad" name="cantidad" placeholder="cantidad disponible" required>
    </div>

    <div class="mb-3">
      <label for="observaciones" class="form-label">observaciones</label>
      <input type="text" value="<%= old.observaciones%>" class="form-control" id="observaciones" name="observaciones" placeholder="Alguna observacion" required>
    </div>
    <div class="mb-3">
      <% if(errores){ %>
      <% if(errores.fecha_devolucion) {%>
        <p class="text-danger"><%= errores.fecha_devolucion.msg %></p>
      <% } %>
      <% } %>
        <label for="fecha_devolucion" class="form-label">Fecha de devolucion estimada</label>
        <input type="datetime" value="<%= old.fecha_devolucion %>" class="form-control" id="fecha_devolucion" name="fecha_devolucion" placeholder="MM/DD/YYYY HH:MM" required>
      </div>
    
    <button type="submit" class="btn btn-primary">Registrar Préstamo</button>
    <a href="/prestamos" class="btn btn-secondary">Cancelar</a>
  </form>
</div>
  <script src="/js/prestamosRegister.js"></script>
</body>
</html>

