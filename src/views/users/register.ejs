<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>  
<body>
<div class="container mt-5 col-md-6">
  <h2 class="text-center mb-4">Registro de Usuario</h2>
  <form method="POST" id="registerForm" action="/users/register" enctype="multipart/form-data">
    <div class="mb-3">
       <% if(locals.errores && errores.username){ %>
            <p class="errorText"><%= errores.username.msg %></p>
          <% } %>
      <label for="username" class="form-label">Nombre de usuario</label>
      <input type="text" class="form-control" id="username" name="username" value="<%= locals.old && old.username ? old.username : '' %>">
    </div>
    
    <div class="mb-3">
       <% if(locals.errores && errores.nombre){ %>
            <p class="errorText"><%= errores.nombre.msg %></p>
          <% } %>
      <label for="nombre" class="form-label">Nombre completo</label>
      <input type="text" class="form-control" id="nombre" name="nombre" value="<%= locals.old && old.nombre ? old.nombre : '' %>">
    </div>
    
    <div class="mb-3">
      <label for="img" class="form-label">Foto del usuario</label>
      <input type="file" class="form-control" id="img" name="imagen">
    </div>

    <div class="mb-3">
       <% if(locals.errores && errores.email){ %>
            <p class="errorText"><%= errores.email.msg %></p>
          <% } %>
      <label for="email" class="form-label">Correo electrónico</label>
      <input type="email" class="form-control" id="email" name="email" value="<%= locals.old && old.email ? old.email : '' %>">
    </div>

    <!-- Sección de contraseña con validador -->
    <div class="mb-3">
       <% if(locals.errores && errores.password){ %>
            <p class="errorText"><%= errores.password.msg %></p>
          <% } %>
      <label for="password" class="form-label">Contraseña</label>
      <div class="password-input-group">
        <input type="password" class="form-control" id="password" name="password" 
               placeholder="Escribe tu contraseña..." 
               value="<%= locals.old && old.password ? old.password : '' %>">
        <button type="button" class="password-toggle" id="togglePassword">
          <i class="bi bi-eye"></i>
        </button>
      </div>
      
      <!-- Indicador de fortaleza -->
      <div class="password-strength mt-2">
        <div class="strength-label">Fortaleza: <span id="strengthText">No ingresada</span></div>
        <div class="strength-bar">
          <div id="strengthFill" class="strength-fill"></div>
        </div>
      </div>
      
      <!-- Requisitos de seguridad -->
      <div class="password-requirements mt-3">
        <p class="requirements-title mb-2">Requisitos de seguridad:</p>
        <ul class="requirement-list" id="requirementList">
          <!-- Los requisitos se cargarán con JavaScript -->
        </ul>
      </div>
    </div>

    <div class="mb-3">
      <label for="repeat_password" class="form-label">Repite Contraseña</label>
      <div class="password-input-group">
        <input type="password" class="form-control" id="repeat_password" name="repass" 
               placeholder="Repite la contraseña...">
        <button type="button" class="password-toggle" id="toggleRepeatPassword">
          <i class="bi bi-eye"></i>
        </button>
      </div>
      <div id="passwordMatchMessage" class="mt-2"></div>
    </div>
    
    <div class="password-suggestions mb-4">
      <p class="suggestions-title"><i class="bi bi-lightbulb"></i> Sugerencias para una contraseña segura:</p>
      <ul class="suggestions-list">
        <li>Usa al menos 12 caracteres</li>
        <li>Combina mayúsculas, minúsculas, números y símbolos</li>
        <li>Evita información personal como nombres o fechas</li>
      </ul>
      <button type="button" class="btn btn-outline-secondary btn-sm mt-2" id="generatePassword">
        <i class="bi bi-key"></i> Generar contraseña segura
      </button>
    </div>

    <button type="submit" class="btn btn-success w-100" id="submitBtn">Registrarse</button>
    <p class="text-center mt-3">¿Ya tienes una cuenta? <a href="/users/login">Inicia sesión</a></p>
  </form>
</div>

<!-- Enlace a Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<!-- Estilos específicos para el validador de contraseñas -->
<link rel="stylesheet" href="/css/password-validator.css">

<!-- Scripts -->
<script src="/js/password-validator.js"></script>
<script src="/js/register.js"></script>
</body>
</html>