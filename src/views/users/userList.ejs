<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head.ejs') %>
<body>
<%- include('../partials/header') %>
  <div class=" mt-4">
  <div class="container mt-4">
  <h2 class="mb-4">Listado de Usuarios</h2>
    
  <% if (adminNotificacion && usuario.role_id == 1) { %>
<div class="alert alert-warning mt-3">
    Hay usuarios cuya fecha de eliminación ya venció. Puedes eliminarlos definitivamente.
</div>
<% } %>

 <form class="d-flex mb-3" method="POST" action="/users">
    <input class="form-control me-2" type="search" placeholder="Buscar Usuario por id,nombre de usuario, nombre,correo, rol o estado" name="q">
    <button class="btn btn-outline-primary" type="submit">Buscar</button>
  </form>
  <div class="button_sd" style="display: flex; justify-content: flex-end; align-items: center; margin-bottom: 20px;">

   <form action="/users/generate-pdf-users" method="post">
    <input type="submit" value="Generar Reporte PDF" class="btn btn-danger mb-3">
  </form>
  </div>


</div>
  <div class="table-responsive">
<table class="table table-hover table-bordered">
  <thead class="table-dark">
    <tr>
      <th>ID</th>
      <th>Nombre de Usuario</th>
      <th>Nombre</th>
      <th>Email</th>
      <th>Rol</th>
      <th>Estado</th>
      <th>Fecha de Eliminacion</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% usuarios.forEach(u => { %>
      <tr class="<%= u.puedeEliminarse ? 'table-danger' : '' %>" data-id="<%= u.id %>">
        <td><%= u.id %></td>
        <td><%= u.user_name %></td>
        <td><%= u.nombre %></td>
        <td><%= u.email %></td>
        <td><%= u.role_id %></td>
        <td>

          <% if (u.bloqueado) { %>
            <span class="text-danger">Bloqueado</span>
          <% } else { %>
            <span class="text-success">Activo</span>
          <% } %>
        </td>
        <td><%= u.fecha_eliminacion_programada ? u.fecha_eliminacion_programada : "Ninguna"  %></td>
        <td>
           <% if( u.user_name != usuario.user_name){ %>
          
                    <% if(usuario.role_id != 3){ %>
                      <button class="bloquear-btn btn btn-warning">
                        <%= u.bloqueado ? "Desbloquear" : "Bloquear" %>
                      </button>
<% } %>
          <% if(!u.fecha_eliminacion_programada && usuario.role_id != 3){ %>
            <button class="eliminar-btn btn btn-danger">Eliminar</button>
             <% }else if(u.puedeEliminarse){ %>
              <form action="/users/eliminar-definitivo/<%= u.id%>" method="post">
                <button class="btn btn-danger btn-sm">Eliminar definitivamente</button>
              </form>
                <button class="cancelar-btn btn btn-danger">Cancelar</button>
            <% }else{ %>
              <button class="cancelar-btn btn btn-danger">Cancelar</button>
            <% } %>
            <% }else{ %>
              <span>N/A</span>
              <% } %>  
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<script src="/js/usuarios.js"></script>

</body>
</html>