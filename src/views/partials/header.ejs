<header class="d-flex justify-content-center align-items-center">
  <nav>
    <a href="/" class="btn btn-light btn-sm">Inicio</a>
    <% if(!usuario) { %>
    <a href="/users/register" class="btn btn-light btn-sm">Registrarse</a>
    <a href="/users/login" class="btn btn-light btn-sm">Iniciar Sesion</a>
    <% } %>
    <% if(usuario) { %>
        <% if(usuario.role_id != 3){ %>
      <a href="/estudiantes" class="btn btn-light btn-sm">Alumnos</a>
      <% } %>
      <a href="/herramientas" class="btn btn-light btn-sm">Herramientas</a>
      <a href="/prestamos" class="btn btn-light btn-sm">Préstamos</a>
      
      <% if(usuario.role_id != 3){%>
      <a href="/audit" class="btn btn-light btn-sm">Acciones del Usuario</a>
        <% if(usuario.role_id != 2){ %>
      <a href="/users/" class="btn btn-light btn-sm">Usuarios</a>
      <% } %>
    <% } %>
    
    <a href="/insumos" class="btn btn-light btn-sm">Insumos</a>
    <a href="/usosInsumos" class="btn btn-light btn-sm">Usos de insumos</a>
    <a href="/users/profile" class="btn btn-light btn-sm m-2"><span class="me-2">Hola, <%= usuario.nombre %>!</span>
      <img src="<%= usuario.img_user ? '/img/users/' + usuario.img_user : '/img/users/default-user.png' %>" alt="Avatar" class="rounded-circle" width="30" height="30">
</a>
    <% } %>
  </nav>
</header>
